<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="393.0" prefWidth="460.0" styleClass="root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rplbo.ukdw.todolistfix.controller.LoginController">
    <children>
        <ImageView fitHeight="453.0" fitWidth="750.0" layoutX="-169.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/img1.jpg" />
            </image>
        </ImageView>
        <!-- Right side with login form -->
        <VBox alignment="CENTER" prefHeight="393.0" prefWidth="460.0" spacing="20.0">
            <children>
                <Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="333.0" prefWidth="300.0" style="-fx-background-color: white; -fx-background-radius: 35; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.3), 10, 0.5, 0, 0);">
                    <children>
                        <Label layoutX="110.0" layoutY="7.0" style="-fx-font-weight: bold;" text="Login">
                            <font>
                                <Font name="Arial Black" size="24.0" />
                            </font>
                        </Label>

                        <Label layoutX="13.0" layoutY="81.0" style="-fx-font-weight: bold;" text="Username">
                            <font>
                                <Font name="Arial" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="usernameField" layoutX="13.0" layoutY="100.0" prefHeight="35.0" prefWidth="274.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);" />

                        <Label layoutX="13.0" layoutY="151.0" style="-fx-font-weight: bold;" text="Password">
                            <font>
                                <Font name="Arial" size="14.0" />
                            </font>
                        </Label>
                        <PasswordField fx:id="passwordField" layoutX="13.0" layoutY="170.0" onAction="#handleLogin" prefHeight="35.0" prefWidth="274.0" style="-fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #e0e0e0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);" />
                        <Button fx:id="loginButton" layoutX="13.0" layoutY="230.0" mnemonicParsing="false" onKeyPressed="#onKeyPressEvent" prefHeight="40.0" prefWidth="274.0" style="-fx-background-color: #F28B3D; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 5, 0, 0, 0);" text="Login">
                            <font>
                                <Font name="Arial Bold" size="14.0" />
                            </font>
                        </Button>
                        <Label fx:id="registerLabel" layoutX="69.0" layoutY="289.0" style="-fx-text-fill: #F28B3D; -fx-cursor: hand;" text="Belum punya akun? Daftar">
                            <font>
                                <Font name="Arial" size="13.0" />
                            </font>
                        </Label>
                  <Label fx:id="errorLabel" alignment="CENTER" contentDisplay="CENTER" layoutX="16.0" layoutY="45.0" prefHeight="23.0" prefWidth="263.0" textAlignment="CENTER" textFill="#ff3c3c">
                     <font>
                        <Font name="Arial Bold" size="12.0" />
                     </font></Label>
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </Pane>
            </children>
        </VBox>
      <ImageView fx:id="closeLogin" fitHeight="40.0" fitWidth="72.0" layoutX="400.0" layoutY="10.0" onMouseClicked="#onCloseLogin" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/close.png" />
         </image>
      </ImageView>
    </children>
</AnchorPane>

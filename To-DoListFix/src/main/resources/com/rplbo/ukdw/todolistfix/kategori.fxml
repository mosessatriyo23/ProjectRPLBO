                </HBox>
                <HBox fx:id="btnKategori" alignment="CENTER" onMouseClicked="#handleKategoriClick" prefHeight="35.0" prefWidth="150.0" styleClass="selected" stylesheets="@../css/styles.css">
                    <children>
                        <ImageView fx:id="lgKategori" fitHeight="15.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/application.png" /></image>

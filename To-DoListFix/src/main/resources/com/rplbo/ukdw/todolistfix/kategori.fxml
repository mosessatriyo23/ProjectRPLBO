                            <image><Image url="@../images/logout.png" /></image>
                        </ImageView>
                        <Label onMouseClicked="#handleLogoutClick" prefHeight="35.0" prefWidth="70.0" styleClass="sidebar-label" stylesheets="@../css/styles.css" text="Log Out">
                            <HBox.margin><Insets left="5.0" /></HBox.margin>
                        </Label>
                    </children>
                </HBox>
            </children>

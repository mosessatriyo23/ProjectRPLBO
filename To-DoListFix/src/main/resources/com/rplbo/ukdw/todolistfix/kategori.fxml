                        <ImageView fx:id="lgPrioritas" fitHeight="35.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/star.png" /></image>
                        </ImageView>
                        <Label fx:id="lblPrioritas1" prefHeight="35.0" prefWidth="75.0" styleClass="sidebar-label" text="Prioritas">
                            <HBox.margin><Insets left="5.0" /></HBox.margin>
                        </Label>
                    </children>
                </HBox>
                <Pane prefHeight="135.0" prefWidth="135.0">
                    <children>
                        <HBox fx:id="btnExit" alignment="CENTER_LEFT" layoutY="96.0" onMouseClicked="#handleExitClick" prefHeight="41.0" prefWidth="135.0" styleClass="sidebar-item-exitlogout" stylesheets="@../css/styles.css">
                            <children>
                                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true" styleClass="sidebar-icon">
                                    <image><Image url="@../images/exit.png" /></image>
                                </ImageView>
                                <Label onMouseClicked="#handleExitClick" prefHeight="35.0" prefWidth="70.0" styleClass="sidebar-label" stylesheets="@../css/styles.css" text="Exit">
                                    <HBox.margin><Insets /></HBox.margin>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </Pane>

                <HBox fx:id="btnLogOut" alignment="CENTER" onMouseClicked="#handleLogoutClick" prefHeight="35.0" prefWidth="150.0" styleClass="sidebar-item-exitlogout" stylesheets="@../css/styles.css">

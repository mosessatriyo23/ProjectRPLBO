            <!-- Page Header -->
            <HBox alignment="CENTER_LEFT" prefHeight="50.0" spacing="12">
                <children>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <children>
                            <Label fx:id="lblJumlahKategori" styleClass="page-title" stylesheets="@../css/styles.css" text="Semua Kategori" />
                            <Label styleClass="page-subtitle" stylesheets="@../css/styles.css" text="Kelola semua kategori tugasmu" />
                        </children>
                    </VBox>
                    <!-- Action Buttons aligned right -->
                    <HBox alignment="CENTER_RIGHT" prefHeight="58.0" prefWidth="334.0" spacing="10">
                        <children>
                            <Button onAction="#handleTambahKategori" prefHeight="34.0" prefWidth="110.0" styleClass="btn-primary" stylesheets="@../css/styles.css" text="+ Tambah">
                                <font><Font name="Arial Bold" size="12.0" /></font>
                            </Button>
                            <Button fx:id="btnEditKategori" onAction="#handleEditKategori" prefHeight="34.0" prefWidth="89.0" styleClass="btn-secondary" stylesheets="@../css/styles.css" text="✎ Edit" />
                            <Button fx:id="btnHapusKategori" onAction="#handleHapusKategori" prefHeight="34.0" prefWidth="106.0" styleClass="btn-danger" stylesheets="@../css/styles.css" text="✕ Hapus">
                                <font><Font name="Arial Bold" size="12.0" /></font>
                            </Button>
                        </children>
                    </HBox>
                </children>
                <VBox.margin><Insets bottom="16.0" /></VBox.margin>
            </HBox>

            <!-- Table -->
            <TableView fx:id="tabell" prefHeight="340.0" prefWidth="619.0" styleClass="custom-table" stylesheets="@../css/styles.css" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="no" prefWidth="50.0" text="No" />
                    <TableColumn fx:id="namaKategori" prefWidth="160.0" text="Nama Kategori" />
                    <TableColumn fx:id="deskripsi" prefWidth="200.0" text="Deskripsi" />
